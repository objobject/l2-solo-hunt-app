{
  "name": "l2-solo-hunt-calc-rewrite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chronicle 1 raw wiki scraper for the Lineage 2 Reborn Legacy Solo Hunt Calculator",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scrape": "tsx src/cli.ts scrape",
    "normalize": "tsx src/cli.ts normalize",
    "generate": "tsx src/cli.ts generate",
    "verify-data": "tsx src/cli.ts verify-data",
    "generated-data:check": "tsx src/cli.ts generated-data:check",
    "diff-data": "tsx src/cli.ts diff-data"
  },
  "dependencies": {
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
